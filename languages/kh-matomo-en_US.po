#: includes/admin.php:29
msgid "Matomo Tracker"
msgstr "Matomo Tracker"

#: includes/admin.php:100
msgid "Introduce la URL base HTTPS de Matomo, sin /matomo.php ni /index.php."
msgstr "Enter the Matomo base HTTPS URL without /matomo.php or /index.php."

#: includes/admin.php:111
msgid "El Site ID debe ser un número entero positivo."
msgstr "The Site ID must be a positive integer."

#: includes/admin.php:123
msgid "Introduce el token de autenticación de Matomo."
msgstr "Enter the Matomo authentication token."

#: includes/admin.php:151
msgid "No tienes autorización."
msgstr "You are not authorized."

#: includes/admin.php:161
msgid "La sesión expiró. Recarga la página e inténtalo de nuevo."
msgstr "Your session expired. Reload the page and try again."

#: includes/admin.php:181
msgid "Error de validación."
msgstr "Validation error."

#: includes/admin.php:199
msgid "No se pudo completar la prueba de conexión."
msgstr "The connection test could not be completed."

#: includes/admin.php:205
msgid "Resultado inesperado."
msgstr "Unexpected result."

#: includes/admin.php:221
msgid "Conexión con Matomo"
msgstr "Matomo connection"

#: includes/admin.php:224
msgid ""
"Configura la instancia de Matomo que recibirá los eventos de seguimiento de "
"YOURLS."
msgstr ""
"Configure the Matomo instance that will receive YOURLS tracking events."

#: includes/admin.php:230
msgid "URL base de Matomo"
msgstr "Matomo base URL"

#: includes/admin.php:243
msgid ""
"Escribe el dominio o la carpeta donde está instalado Matomo, sin añadir /"
"matomo.php ni /index.php."
msgstr ""
"Enter the domain or directory where Matomo is installed. Do not add /"
"matomo.php or /index.php."

#: includes/admin.php:250
msgid "Site ID"
msgstr "Site ID"

#: includes/admin.php:266
msgid "Token de autenticación"
msgstr "Authentication token"

#: includes/admin.php:273
msgid ""
"Token configurado. Introduce uno nuevo únicamente si deseas reemplazarlo. El "
"usuario del token necesita permiso de escritura en el sitio de Matomo."
msgstr ""
"Token configured. Enter a new one only if you want to replace it. The token "
"user needs write access to the Matomo site."

#: includes/admin.php:278
msgid ""
"No hay ningún token configurado. El usuario del token necesita permiso de "
"escritura en el sitio de Matomo."
msgstr ""
"No token is configured. The token user needs write access to the Matomo site."

#: includes/admin.php:303 includes/admin.php:370
msgid "Seguimiento"
msgstr "Tracking"

#: includes/admin.php:307
msgid "Habilitar seguimiento"
msgstr "Enable tracking"

#: includes/admin.php:315
msgid "Enviar eventos de redirección a Matomo."
msgstr "Send redirect events to Matomo."

#: includes/admin.php:321
msgid "Anonimizar IP"
msgstr "Anonymize IP"

#: includes/admin.php:329
msgid "Anonimizar la IP antes de enviarla a Matomo."
msgstr "Anonymize the IP address before sending it to Matomo."

#: includes/admin.php:332
msgid ""
"IPv4 se reduce a /24 e IPv6 a /64. Si desactivas esta opción, se enviará la "
"IP completa."
msgstr ""
"IPv4 addresses are masked to /24 and IPv6 addresses to /64. If you disable "
"this option, the full IP address will be sent."

#: includes/admin.php:355
msgid "Estado"
msgstr "Status"

#: includes/admin.php:359
msgid "Configuración"
msgstr "Configuration"

#: includes/admin.php:362
msgid "Credenciales configuradas."
msgstr "Credentials configured."

#: includes/admin.php:364
msgid "Configuración pendiente."
msgstr "Configuration pending."

#: includes/admin.php:373
msgid "Habilitado"
msgstr "Enabled"

#: includes/admin.php:375
msgid "Deshabilitado"
msgstr "Disabled"

#: includes/admin.php:381
msgid "Versión del plugin"
msgstr "Plugin version"

#: includes/admin.php:386
msgid "Actualización disponible:"
msgstr "Update available:"

#: includes/admin.php:475
msgid "No fue posible guardar la configuración."
msgstr "Could not save the configuration."

#: includes/admin.php:481
msgid "La configuración de Matomo se guardó correctamente."
msgstr "Matomo settings saved successfully."

#: includes/admin.php:503
msgid "KH Matomo"
msgstr "KH Matomo"

#: includes/admin.php:512
msgid ""
"Integración de seguimiento de clics del lado del servidor entre YOURLS y "
"Matomo."
msgstr "Server-side click tracking integration between YOURLS and Matomo."

#: includes/admin.php:530 includes/admin.php:588
msgid "Probar conexión"
msgstr "Test connection"

#: includes/admin.php:533
msgid ""
"La prueba es opcional para guardar. Deja el campo del token vacío para "
"conservar el token actual."
msgstr ""
"Testing is optional when saving. Leave the token field blank to keep the "
"current token."

#: includes/admin.php:557
msgid "Guardar configuración"
msgstr "Save settings"

#: includes/admin.php:582
msgid "Probando conexión..."
msgstr "Testing connection..."

#: includes/admin.php:583
msgid "Comunicando con Matomo..."
msgstr "Contacting Matomo..."

#: includes/admin.php:584
#, php-format
msgid ""
"YOURLS devolvió una respuesta vacía (HTTP %s). La acción AJAX no produjo "
"JSON. URL: %s"
msgstr ""
"YOURLS returned an empty response (HTTP %s). The AJAX action did not produce "
"JSON. URL: %s"

#: includes/admin.php:585
#, php-format
msgid "YOURLS devolvió una respuesta no JSON (HTTP %s): %s"
msgstr "YOURLS returned a non-JSON response (HTTP %s): %s"

#: includes/admin.php:586
#, php-format
msgid "La solicitud fue rechazada por YOURLS (HTTP %s)."
msgstr "The request was rejected by YOURLS (HTTP %s)."

#: includes/admin.php:587
msgid "No fue posible validar la conexión."
msgstr "Could not validate the connection."

#: includes/admin.php:589
#, php-format
msgid " [etapa: %s]"
msgstr " [stage: %s]"

#: includes/matomo-api.php:23
msgid "La extensión PHP cURL no está disponible."
msgstr "The PHP cURL extension is not available."

#: includes/matomo-api.php:38
msgid "La URL y el token de Matomo son obligatorios."
msgstr "The Matomo URL and token are required."

#: includes/matomo-api.php:60
msgid "No fue posible inicializar la conexión con Matomo."
msgstr "Could not initialize the connection to Matomo."

#: includes/matomo-api.php:91
msgid ""
"No fue posible establecer comunicación con Matomo. Verifica la URL y la "
"disponibilidad del servicio."
msgstr ""
"Could not communicate with Matomo. Check the URL and service availability."

#: includes/matomo-api.php:100
#, php-format
msgid "Matomo respondió con HTTP %1$s. Respuesta: %2$s"
msgstr "Matomo returned HTTP %1$s. Response: %2$s"

#: includes/matomo-api.php:113
msgid "Matomo respondió con un formato de datos inesperado."
msgstr "Matomo returned an unexpected data format."

#: includes/matomo-api.php:124
msgid ""
"Matomo rechazó la solicitud. Verifica el token y los permisos de la cuenta."
msgstr "Matomo rejected the request. Check the token and account permissions."

#: includes/matomo-api.php:131
msgid "Solicitud procesada correctamente."
msgstr "Request processed successfully."

#: includes/matomo-api.php:242
msgid "El Site ID no es válido."
msgstr "The Site ID is invalid."

#: includes/matomo-api.php:264
msgid "Matomo devolvió una respuesta de permisos inesperada."
msgstr "Matomo returned an unexpected permissions response."

#: includes/matomo-api.php:272
msgid ""
"Conexión correcta. El token puede registrar eventos en el sitio configurado."
msgstr ""
"Connection successful. The token can record events on the configured site."

#: includes/matomo-api.php:281
#, php-format
msgid "No se pudieron verificar los permisos del token en Matomo. %s"
msgstr "Could not verify the token permissions in Matomo. %s"

#: includes/matomo-api.php:289
msgid ""
"El token no tiene permisos de escritura ni de administración en el sitio "
"configurado."
msgstr ""
"The token does not have write or administrator access to the configured site."

#: includes/admin.php
msgid "Respuesta exitosa"
msgstr "Successful response"

#: includes/admin.php
msgid "Error de transporte"
msgstr "Transport error"

#: includes/admin.php
msgid "Respuesta HTTP no exitosa"
msgstr "Unsuccessful HTTP response"

#: includes/admin.php
msgid "cURL no disponible"
msgstr "cURL unavailable"

#: includes/admin.php
msgid "No se pudo iniciar cURL"
msgstr "Could not initialize cURL"

#: includes/admin.php
msgid "Configuración incompleta"
msgstr "Incomplete configuration"

#: includes/admin.php
msgid "Error interno"
msgstr "Internal error"

#: includes/admin.php
msgid "Diagnóstico de envíos"
msgstr "Delivery diagnostics"

#: includes/admin.php
msgid "Muestra de respuestas del seguimiento: se guarda como máximo un éxito y un fallo por minuto, salvo solicitudes concurrentes. Puede omitir resultados intermedios. La prueba de conexión no se incluye."
msgstr "Sampled tracking responses: at most one success and one failure are saved per minute, except for concurrent requests. Intermediate results may be omitted. Connection tests are excluded."

#: includes/admin.php
msgid "Una respuesta exitosa no confirma que el evento aparezca en los informes de Matomo. Las fechas usan la zona horaria y el formato configurados en YOURLS."
msgstr "A successful response does not confirm that the event appears in Matomo reports. Dates use the timezone and format configured in YOURLS."

#: includes/admin.php
msgid "Último éxito registrado"
msgstr "Last recorded success"

#: includes/admin.php
msgid "Último fallo registrado"
msgstr "Last recorded failure"

#: includes/admin.php
msgid "Sin registros."
msgstr "No records."

#: includes/admin.php
#, php-format
msgid "HTTP: %1$d · cURL: %2$d · Duración: %3$d ms"
msgstr "HTTP: %1$d · cURL: %2$d · Duration: %3$d ms"

#: includes/admin.php
msgid "Duración"
msgstr "Duration"

#: includes/admin.php
msgid "Tiempo de espera agotado"
msgstr "Request timed out"

#: includes/admin.php
msgid "Historial de muestras"
msgstr "Sample history"

#: includes/admin.php
msgid "Fecha"
msgstr "Date"

#: includes/admin.php
msgid "Resultado"
msgstr "Result"

#: includes/admin.php
msgid "Borrar historial de muestras"
msgstr "Clear sample history"

#: includes/admin.php
msgid "Hasta 10 éxitos y 10 fallos recientes, del más nuevo al más antiguo. No incluye todos los intentos."
msgstr "Up to 10 recent successes and 10 failures, newest first. Not all attempts are included."

#: includes/admin.php
msgid "El historial de muestras se borró. Las tarjetas se conservan."
msgstr "Sample history cleared. Cards are retained."

#: includes/admin.php
msgid "No se pudo borrar el historial de muestras."
msgstr "Could not clear sample history."

#: includes/admin.php
msgid "Enlaces no encontrados"
msgstr "Links not found"

#: includes/admin.php
msgid "Registrar enlaces no encontrados"
msgstr "Track links not found"

#: includes/admin.php
msgid "Envía un evento a Matomo cuando alguien solicita un enlace corto que no existe. Requiere que el seguimiento esté habilitado y no cambia la redirección de YOURLS."
msgstr "Sends an event to Matomo when someone requests a short link that does not exist. Requires tracking to be enabled and does not change the YOURLS redirect."

#: includes/admin.php
msgid "Solo se registran solicitudes GET con formato de keyword válido, hasta 30 intentos de envío por minuto para toda la instalación."
msgstr "Only GET requests with a valid keyword format are tracked, with up to 30 delivery attempts per minute across the installation."
